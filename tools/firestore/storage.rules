rules_version = '2';

// Firebase Storage のセキュリティルール。
//   デプロイ: node deploy-storage-rules.js
//   現状確認: node get-storage-rules.js
//
// 方針:
//   ・読み取りは誰でも可
//     （メニュー画像・アイテムアイコン・ゲーム画像(boardgame_images/)の配信。
//       トークン付きダウンロードURLが主だが、SDK直読みも許可しておく）
//   ・書き込みは admin カスタムクレームを持つアカウントのみ
//     （IconUploader・ゲーム画像かんり(GameImageAdminController)などの店側ツール。
//       一般ユーザーのアプリには Storage へ書き込む経路が存在しない）
//
// ※2025-12時点ではコンソール初期テンプレートの「全開放（read, write: if true）」の
//   まま運用されていたため、2026-07-10 にこの内容へ差し替えた。
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
